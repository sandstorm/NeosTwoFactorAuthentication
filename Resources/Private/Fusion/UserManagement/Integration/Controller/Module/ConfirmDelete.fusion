Sandstorm.NeosTwoFactorAuthentication.UserManagement.ModuleController.confirmDelete = Sandstorm.NeosTwoFactorAuthentication:UserManagement.Page.ModulePage {
    @context.indexUri = Neos.Fusion:UriBuilder {
        action = 'index'
    }
    content = afx`
        <div class="neos-user-management">
            <legend><Sandstorm.NeosTwoFactorAuthentication:UserManagement.T id="module.delete.title" /></legend>
            <p><Sandstorm.NeosTwoFactorAuthentication:UserManagement.T id="module.delete.text" /></p>
            <ul class="neos-user-management__delete-list">
                <Neos.Fusion:Loop items={users} itemName="user">
                    <li>{user.displayName} ({Array.join(user.accountIdentifiers, ', ')})</li>
                </Neos.Fusion:Loop>
            </ul>
            <Neos.Fusion.Form:Form form.target.action="delete" form.target.arguments={{userIds: Array.map(users, user => user.userId)}}>
                <div class="neos-footer">
                    <a href={indexUri} class="neos-button"><Sandstorm.NeosTwoFactorAuthentication:UserManagement.T id="cancel" /></a>
                    <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-danger" attributes.data-test-id="confirm-delete">
                        <Sandstorm.NeosTwoFactorAuthentication:UserManagement.T id="module.delete.confirm" />
                    </Neos.Fusion.Form:Button>
                </div>
            </Neos.Fusion.Form:Form>
        </div>
    `
}
