# Variables: action ('resetPassword' | 'initialPassword'), links (list of {username, uri}), expiresAt, name
# Each part is rendered on its own (UserMailer renders .../subject, .../html, .../text), so the @context
# is set per part and not on the untyped parent path.
Sandstorm.NeosTwoFactorAuthentication.UserManagement.Mail.passwordLinks {
    subject = Sandstorm.NeosTwoFactorAuthentication:UserManagement.Mail.T {
        id = ${(action == 'initialPassword' ? 'mail.initialPassword.' : 'mail.resetPassword.') + 'subject'}
    }

    html = Sandstorm.NeosTwoFactorAuthentication:UserManagement.Mail.HtmlLayout {
        @context.prefix = ${action == 'initialPassword' ? 'mail.initialPassword.' : 'mail.resetPassword.'}
        @context.expires = ${Date.format(expiresAt, 'Y-m-d H:i')}
        content = afx`
            <p><Sandstorm.NeosTwoFactorAuthentication:UserManagement.Mail.T id="mail.greeting" arguments={[String.htmlSpecialChars(name)]} /></p>
            <p><Sandstorm.NeosTwoFactorAuthentication:UserManagement.Mail.T id={prefix + 'intro'} /></p>
            <Neos.Fusion:Loop items={links} itemName="link">
                <p @if={Array.length(links) > 1} style="margin-bottom: 0;">
                    <Sandstorm.NeosTwoFactorAuthentication:UserManagement.Mail.T id="mail.forUsername" arguments={[String.htmlSpecialChars(link.username)]} />
                </p>
                <Sandstorm.NeosTwoFactorAuthentication:UserManagement.Mail.Button href={link.uri}
                    label={I18n.id(prefix + 'button').package('Sandstorm.NeosTwoFactorAuthentication').source('UserManagement').translate()} />
            </Neos.Fusion:Loop>
            <p><Sandstorm.NeosTwoFactorAuthentication:UserManagement.Mail.T id="mail.expires" arguments={[expires]} /></p>
            <p><Sandstorm.NeosTwoFactorAuthentication:UserManagement.Mail.T id={prefix + 'ignore'} /></p>
        `
    }

    text = Neos.Fusion:Value {
        @context.prefix = ${action == 'initialPassword' ? 'mail.initialPassword.' : 'mail.resetPassword.'}
        @context.expires = ${Date.format(expiresAt, 'Y-m-d H:i')}
        value = ${Array.join(Array.concat(
            [
                I18n.id('mail.greeting').package('Sandstorm.NeosTwoFactorAuthentication').source('UserManagement').arguments([name]).translate(),
                '',
                I18n.id(prefix + 'intro').package('Sandstorm.NeosTwoFactorAuthentication').source('UserManagement').translate(),
                ''
            ],
            Array.map(links, link => (Array.length(links) > 1 ? I18n.id('mail.forUsername').package('Sandstorm.NeosTwoFactorAuthentication').source('UserManagement').arguments([link.username]).translate() + String.chr(10) : '') + link.uri + String.chr(10)),
            [
                I18n.id('mail.expires').package('Sandstorm.NeosTwoFactorAuthentication').source('UserManagement').arguments([expires]).translate(),
                '',
                I18n.id(prefix + 'ignore').package('Sandstorm.NeosTwoFactorAuthentication').source('UserManagement').translate()
            ]
        ), String.chr(10))}
    }
}
