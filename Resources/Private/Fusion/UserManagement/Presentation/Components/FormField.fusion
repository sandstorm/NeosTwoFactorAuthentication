# Label + control, Neos backend form markup.
prototype(Sandstorm.NeosTwoFactorAuthentication:UserManagement.Component.FormField) < prototype(Neos.Fusion:Component) {
    labelId = ''
    for = ''
    hint = ''
    content = ''

    renderer = afx`
        <div class="neos-control-group">
            <label class="neos-control-label" for={props.for}>
                <Sandstorm.NeosTwoFactorAuthentication:UserManagement.Translate id={props.labelId} />
            </label>
            <div class="neos-controls">
                {props.content}
                <p @if={props.hint} class="neos-user-management__hint">{props.hint}</p>
            </div>
        </div>
    `
}

# Checkbox list of all assignable roles.
prototype(Sandstorm.NeosTwoFactorAuthentication:UserManagement.Component.RoleCheckboxes) < prototype(Neos.Fusion:Component) {
    roles = ${[]}
    selectedRoleIdentifiers = ${[]}
    idPrefix = 'role'

    renderer = afx`
        <div class="neos-user-management__roles">
            <Neos.Fusion:Loop items={props.roles} itemName="role" iterationName="iteration">
                <label class="neos-checkbox neos-user-management__checkbox" for={props.idPrefix + '-' + iteration.index}>
                    <Neos.Fusion.Form:Checkbox
                        field.name="roleIdentifiers"
                        field.multiple={true}
                        field.value={role.identifier}
                        attributes.id={props.idPrefix + '-' + iteration.index}
                        attributes.checked={Array.indexOf(props.selectedRoleIdentifiers, role.identifier) > -1}
                    />
                    <span></span>
                    {role.label} <small>({role.identifier})</small>
                </label>
            </Neos.Fusion:Loop>
        </div>
    `
}
